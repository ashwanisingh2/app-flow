<UserControl
    x:Class="AppFlow.UI.Controls.AppCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppFlow.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="280" Height="120" 
            CornerRadius="{StaticResource AppFlowCardCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            Padding="{StaticResource AppFlowCardPadding}">
        <StackPanel>
            <TextBlock Text="{x:Bind PackageName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind Publisher, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <local:SourceBadge SourceId="{x:Bind SourceId, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="4">
                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource AppFlowSuccessBrush}" Visibility="{x:Bind IsInstalled, Mode=OneWay}"/>
                <TextBlock Text="Installed" FontSize="11" Foreground="{StaticResource AppFlowSuccessBrush}" Visibility="{x:Bind IsInstalled, Mode=OneWay}"/>
                
                <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="{StaticResource AppFlowWarningBrush}" Visibility="{x:Bind HasUpdate, Mode=OneWay}" Margin="8,0,0,0"/>
                <TextBlock Text="Update available" FontSize="11" Foreground="{StaticResource AppFlowWarningBrush}" Visibility="{x:Bind HasUpdate, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
