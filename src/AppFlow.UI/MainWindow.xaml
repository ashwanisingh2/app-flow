<Window
    x:Class="AppFlow.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppFlow.UI"
    xmlns:views="using:AppFlow.UI.Views"
    Title="AppFlow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71E;" FontSize="18" Foreground="{StaticResource AppFlowAccentBrush}"/>
                <TextBlock Text="AppFlow" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
            </StackPanel>

            <!-- Global Search Bar -->
            <AutoSuggestBox x:Name="GlobalSearchBox" Grid.Column="1"
                            PlaceholderText="&#xE721; Search apps across all sources..."
                            QueryIcon="Find"
                            MaxWidth="600"
                            Margin="24,0"
                            VerticalAlignment="Center"
                            QuerySubmitted="GlobalSearchBox_QuerySubmitted"/>

            <!-- Theme Toggle -->
            <ToggleButton x:Name="ThemeToggle" Grid.Column="2"
                          VerticalAlignment="Center"
                          Click="ThemeToggle_Click"
                          ToolTipService.ToolTip="Toggle Dark/Light Mode"
                          Background="Transparent" BorderThickness="0">
                <FontIcon x:Name="ThemeIcon" Glyph="&#xE793;" FontSize="16"/>
            </ToggleButton>
        </Grid>

        <!-- Navigation View -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Auto"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        IsPaneOpen="False"
                        SelectionChanged="NavView_SelectionChanged"
                        BackRequested="NavView_BackRequested">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home"/>
                <NavigationViewItem Content="Search" Tag="search" Icon="Find"/>
                <NavigationViewItem Content="Favorites" Tag="favorites" Icon="Favorite"/>
                <NavigationViewItem Content="History" Tag="history" Icon="Clock"/>
                <NavigationViewItem Content="Sources" Tag="sources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Padding="24"/>

        </NavigationView>
    </Grid>
</Window>
