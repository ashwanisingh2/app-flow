<Page
    x:Class="AppFlow.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>

            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <RadioButtons SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                    <x:String>System</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Safety" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <ToggleSwitch Header="Security validation (required)" IsOn="True" IsEnabled="False"/>
                <TextBlock Text="Checks HTTPS, SHA-256 checksums, source trust, and local Authenticode signatures."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <ToggleSwitch Header="Source locking (required)" IsOn="True" IsEnabled="False"/>
                <TextBlock Text="Updates, repairs, and uninstalls are routed through the original source."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Search" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <NumberBox Header="Source timeout (seconds)" Minimum="1" Maximum="60"
                           Value="{x:Bind ViewModel.QueryTimeoutSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                <NumberBox Header="Maximum results" Minimum="1" Maximum="500"
                           Value="{x:Bind ViewModel.MaxSearchResults, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save settings" Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}"/>
                <Button Content="Export installed packages"
                        Command="{x:Bind ViewModel.ExportPackageListCommand}"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <StackPanel Spacing="4" Margin="0,16,0,0">
                <TextBlock Text="AppFlow" FontWeight="SemiBold"/>
                <TextBlock Text="Version 1.0.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
