<Page
    x:Class="AppFlow.UI.Views.AppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppFlow.UI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="64" Height="64" CornerRadius="8" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <FontIcon Glyph="&#xE718;" FontSize="32" Foreground="{StaticResource AppFlowAccentBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PackageDetail.Name, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.PackageDetail.Publisher, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                
                <ToggleButton Margin="auto,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{x:Bind ViewModel.IsFavorite, Mode=TwoWay}"
                              Command="{x:Bind ViewModel.ToggleFavoriteCommand}">
                    <FontIcon Glyph="&#xE734;" /> <!-- Star -->
                </ToggleButton>
            </StackPanel>
        </StackPanel>

        <!-- Details & Actions -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Info Left -->
            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="Details" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.PackageDetail.Description, Mode=OneWay}" TextWrapping="Wrap"/>
                
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.PackageDetail.LatestVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Source" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.PackageDetail.SourceId, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Actions Right -->
            <Border Grid.Column="1" CornerRadius="{StaticResource AppFlowCardCornerRadius}" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="{StaticResource AppFlowCardPadding}">
                <StackPanel Spacing="12">
                    <Button Content="Install" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InstallCommand}" IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                    
                    <Button Content="Update" HorizontalAlignment="Stretch" 
                            Command="{x:Bind ViewModel.UpdateCommand}" IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                            
                    <Button Content="Uninstall" HorizontalAlignment="Stretch" 
                            Command="{x:Bind ViewModel.UninstallCommand}" IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                            
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsExecuting, Mode=OneWay}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log Output -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <ScrollViewer>
                <ItemsControl ItemsSource="{x:Bind ViewModel.LogOutput, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Code" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
