<Page
    x:Class="AppFlow.UI.Views.AppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <FontIcon Glyph="&#xE718;" FontSize="32" Foreground="{StaticResource AppFlowAccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.PackageDetail.Name, Mode=OneWay}"
                           Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.PackageDetail.Publisher, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ToggleButton Grid.Column="2" VerticalAlignment="Center"
                          IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                          ToolTipService.ToolTip="Toggle favorite">
                <FontIcon Glyph="&#xE734;"/>
            </ToggleButton>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="Details" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.PackageDetail.Description, Mode=OneWay}"
                           TextWrapping="Wrap"/>
                <Grid ColumnSpacing="24" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Installed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.PackageDetail.InstalledVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Latest" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.PackageDetail.LatestVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Source" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.SourceOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSourceOption, Mode=TwoWay}"
                                  MinWidth="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SourceId}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Version}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Grid.Column="1"
                    CornerRadius="{StaticResource AppFlowCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="{StaticResource AppFlowCardPadding}">
                <StackPanel Spacing="10">
                    <Button Content="Install" HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InstallCommand}"
                            IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                    <Button Content="Update" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.UpdateCommand}"
                            IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{x:Bind ViewModel.HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Repair" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RepairCommand}"
                            IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Uninstall" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.UninstallCommand}"
                            IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Cancel" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CancelActionCommand}"
                            Visibility="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.LogOutput, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono"
                                       Foreground="#CCCCCC" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
